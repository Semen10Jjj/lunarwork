	local _g_ = game
	local _w_ = workspace
	if not (_g_ and _w_ and typeof and typeof(_g_) == "Instance" and typeof(_w_) == "Instance") then
		return
	end

	local _dm_name_ = _g_.ClassName
	local _ws_name_ = _w_.ClassName
	if _dm_name_ ~= "DataModel" or _ws_name_ ~= "Workspace" then
		return
	end

	-- Level 1: Anti-Hook & Tamper Guard
	local _ls_ = (getgenv and getgenv().loadstring) or loadstring
	if not _ls_ then
		return
	end

	if islclosure and islclosure(_ls_) then
		while true do end
	end
	if debug and debug.info then
		local s, l = debug.info(_ls_, "sl")
		if s and s ~= "[C]" and s ~= "" then
			while true do end
		end
	end

